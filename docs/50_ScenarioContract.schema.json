
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/scenario-contract.schema.json",
  "title": "ScenarioContract",
  "description": "Contrat JSON d'alimentation du moteur de planification. Document en cours d’alignement avec les contrats JSON stabilisés. La source de vérité actuelle est constituée par les schémas JSON par scénario.",
  "type": "object",
  "required": [
    "scenarioType",
    "planningContext",
    "scenarioParameters",
    "dataSet"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioType": {
      "type": "string",
      "enum": ["SC-01", "SC-02", "SC-03", "SC-04", "SC-05"],
      "description": "Identifiant du scénario métier"
    },
    "planningContext": {
      "type": "object",
      "required": ["horizon", "strategieScoring"],
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "type": "object",
          "required": ["dateDebut", "dateFin"],
          "additionalProperties": false,
          "properties": {
            "dateDebut": { "type": "string", "format": "date" },
            "dateFin": { "type": "string", "format": "date" }
          }
        },
        "strategieScoring": {
          "type": "string",
          "enum": ["EXPLOITATION", "ANALYSE_RH", "AUDIT"]
        },
        "seuils": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "scenarioParameters": {
      "type": "object",
      "description": "Paramètres spécifiques au scénario",
      "additionalProperties": true
    },
    "dataSet": {
      "type": "object",
      "required": ["creneaux", "ressources"],
      "additionalProperties": false,
      "properties": {
        "creneaux": {
          "type": "array",
          "items": { "$ref": "#/definitions/Creneau" }
        },
        "ressources": {
          "type": "object",
          "required": ["salaries"],
          "additionalProperties": false,
          "properties": {
            "salaries": {
              "type": "array",
              "items": { "$ref": "#/definitions/Salarie" }
            },
            "postesVirtuels": {
              "type": "array",
              "items": { "$ref": "#/definitions/PosteVirtuel" },
              "description": "Liste de postes virtuels fournis par l'utilisateur (ex: POTENTIEL) ou par le système."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Creneau": {
      "type": "object",
      "required": [
        "id",
        "date",
        "heureDebut",
        "heureFin",
        "lieu",
        "activite",
        "type"
      ],
      "additionalProperties": false,
      "description": "Créneau à affecter. Les vérités réglementaires (nuit/dimanche/férié) proviennent de RegulatoryParameters et du calcul d'intersection temporelle, pas des flags indicatifs du créneau.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique du créneau"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date de référence du créneau (jour de début si traversée de minuit)."
        },
        "heureDebut": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Heure de début (HH:MM)."
        },
        "heureFin": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Heure de fin (HH:MM). Si heureFin < heureDebut, le créneau traverse minuit."
        },
        "lieu": {
          "type": "string",
          "description": "Code site/lieu. Sert aux compatibilités ressource/lieu si utilisées par le moteur."
        },

        "codeActiviteId": {
          "type": "string",
          "description": "Identifiant d'activité du logiciel de planning (clé de jointure). Recommandé. Si absent, le moteur peut utiliser un fallback sur 'activite' (mode dev/compat)."
        },
        "activite": {
          "type": "string",
          "description": "Libellé d'affichage de l'activité (non utilisé comme clé de jointure si codeActiviteId est fourni)."
        },

        "posteComptable": {
          "type": "string",
          "description": "Code poste comptable (optionnel). Sert aux compatibilités ressource/poste comptable si utilisées."
        },
        "priorite": {
          "type": "integer",
          "minimum": 0,
          "description": "Priorité du créneau (optionnel). 0 = neutre."
        },

        "type": {
          "type": "string",
          "enum": ["IMPOSE", "GENERE"],
          "description": "Type de créneau (imposé ou généré)."
        },

        "isJourFerie": {
          "type": "boolean",
          "description": "INDICATIF (non réglementaire). La vérité 'jour férié' provient de RegulatoryParameters. À conserver uniquement pour compatibilité amont."
        },
        "isReposHebdo": {
          "type": "boolean",
          "description": "INDICATIF (non réglementaire). Peut être utile pour des restitutions/diagnostics, mais ne remplace pas les règles moteur."
        },
        "segmentNuit": {
          "type": "boolean",
          "description": "INDICATIF (non réglementaire). La vérité 'nuit' est calculée par intersection temporelle avec la plage de nuit de RegulatoryParameters."
        },
        "axesOrganisationnels": {
          "type": "object",
          "properties": {
            "directionIds": { "type": "array", "items": { "type": "string" } },
            "serviceIds": { "type": "array", "items": { "type": "string" } },
            "lieuIds": { "type": "array", "items": { "type": "string" } },
            "posteComptableIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "groupeBesoinId": { "type": "string" },
        "blocJourId": { "type": "string" },
        "ordreDansBloc": { "type": "integer" },
        "estSegmentDePause": { "type": "boolean" }   
      }
    },

    "Salarie": {
      "type": "object",
      "required": ["id", "statut", "sitesAutorises", "activitesCompatibles"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "statut": { "type": "string" },
        "sitesAutorises": {
          "type": "array",
          "items": { "type": "string" }
        },
        "activitesCompatibles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Liste des idActivitePlanning compatibles (ex: 10101...). Doit être cohérente avec 'codeActiviteId' des créneaux."
        },
        "axesOrganisationnels": { "$ref": "#/definitions/AxesOrganisationnels" },
        "contratTravail": {
          "type": "object",
          "properties": {
            "dateDebut": { "type": "string" },
            "dateFin": { "type": ["string", "null"] },
            "dureeMoyenneHeuresParJour": { "type": "number" }
            }
        },
        "contraintesReglementaires": {
          "type": "object",
          "properties": {
            "heuresMinimumParJour": { "type": "number" },
            "heuresMaximumParJour": { "type": "number" },
            "amplitudeJournaliereMaximum": { "type": "number" },
            "reposQuotidienMinimum": { "type": "number" },
            "heuresMinimumParSemaine": { "type": "number" },
            "heuresMaximumParSemaine": { "type": "number" },
            "nuitsMaximumParSemaine": { "type": "integer" },
            "joursConsecutifsMaximum": { "type": "integer" }
          }
        }
      }
    },

    "PosteVirtuel": {
      "type": "object",
      "required": [
        "id",
        "type",
        "capaciteCible",
        "activitesAutorisees",
        "lieuxAutorises",
        "postesComptablesCompatibles"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["POTENTIEL", "REVELE"]
        },
        "capaciteCible": {
          "type": "integer",
          "minimum": 0,
          "description": "Capacité cible sur la période (en minutes ou heures selon convention scénario)."
        },
        "activitesAutorisees": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Liste des idActivitePlanning autorisés (ex: 10101...)."
        },
        "lieuxAutorises": {
          "type": "array",
          "items": { "type": "string" }
        },
        "postesComptablesCompatibles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}