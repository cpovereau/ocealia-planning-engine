{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScenarioResponse.schema.json",
  "title": "ScenarioResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioType",
    "solverResult",
    "planning",
    "workMetrics",
    "solutionSummary",
    "diagnostics"
  ],
  "properties": {
    "scenarioType": {
      "type": "string"
    },
    "solverResult": {
      "$ref": "#/$defs/SolverResult"
    },
    "planning": {
      "$ref": "#/$defs/ScenarioPlanning"
    },
    "workMetrics": {
      "$ref": "#/$defs/WorkMetrics"
    },
    "solutionSummary": {
      "$ref": "#/$defs/SolutionSummary"
    },
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    }
  },
  "$defs": {
    "SolverResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score",
        "scoreBreakdown"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SOLVED", "UNSOLVED", "ERROR"]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "scoreBreakdown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreBreakdownItem"
          }
        }
      }
    },

    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft"],
      "properties": {
        "hard": {
          "type": "integer"
        },
        "soft": {
          "type": "integer"
        }
      }
    },

    "ScoreBreakdownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "penaliteKey",
        "unit",
        "quantity",
        "weightedImpact"
      ],
      "properties": {
        "penaliteKey": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": [
            "OCCURRENCE",
            "JOUR",
            "MINUTE_PONDEREE"
          ]
        },
        "quantity": {
          "type": "number"
        },
        "weightedImpact": {
          "type": "integer"
        }
      }
    },

    "ScenarioPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idSalarie",
        "jours"
      ],
      "properties": {
        "idSalarie": {
          "type": "string"
        },
        "jours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JourPlanning"
          }
        }
      }
    },

    "JourPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "creneaux"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "creneaux": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CreneauPlanning"
          }
        }
      }
    },

    "CreneauPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activite",
        "heureDebut",
        "heureFin",
        "duree",
        "ressourceAffecteeId"
      ],
      "properties": {
        "activite": {
          "type": "string"
        },
        "heureDebut": {
          "type": "string"
        },
        "heureFin": {
          "type": "string"
        },
        "duree": {
          "type": "string"
        },
        "nature": {
          "type": ["string", "null"]
        },
        "ressourceAffecteeId": {
          "type": "string"
        }
      }
    },

    "WorkMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byRessource",
        "global"
      ],
      "properties": {
        "byRessource": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkMetricsByRessource"
          }
        },
        "global": {
          "$ref": "#/$defs/GlobalWorkMetrics"
        }
      }
    },

    "WorkMetricsByRessource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "periodeDebut",
        "periodeFin",
        "heuresTravaillees",
        "heuresNuit",
        "heuresJourFerie",
        "heuresReposHebdoTravaille",
        "nbDimanchesTravailles",
        "maxJoursConsecutifsObservees",
        "maxNuitsConsecutivesObservees"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "periodeDebut": {
          "type": "string",
          "format": "date"
        },
        "periodeFin": {
          "type": "string",
          "format": "date"
        },
        "heuresTravaillees": {
          "type": "number"
        },
        "heuresNuit": {
          "type": "number"
        },
        "heuresJourFerie": {
          "type": "number"
        },
        "heuresReposHebdoTravaille": {
          "type": "number"
        },
        "nbDimanchesTravailles": {
          "type": "integer"
        },
        "maxJoursConsecutifsObservees": {
          "type": "integer"
        },
        "maxNuitsConsecutivesObservees": {
          "type": "integer"
        }
      }
    },

    "GlobalWorkMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbCreneaux",
        "nbCreneauxNonAffectes",
        "heuresTravailleesTotales",
        "heuresNuitTotales",
        "heuresJourFerieTotales"
      ],
      "properties": {
        "nbCreneaux": {
          "type": "integer"
        },
        "nbCreneauxNonAffectes": {
          "type": "integer"
        },
        "heuresTravailleesTotales": {
          "type": "number"
        },
        "heuresNuitTotales": {
          "type": "number"
        },
        "heuresJourFerieTotales": {
          "type": "number"
        }
      }
    },

    "SolutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbCreneaux",
        "nbCreneauxAffectes",
        "nbCreneauxNonAffectes",
        "nbRessourcesMobilisees",
        "heuresTravailleesTotales"
      ],
      "properties": {
        "nbCreneaux": {
          "type": "integer"
        },
        "nbCreneauxAffectes": {
          "type": "integer"
        },
        "nbCreneauxNonAffectes": {
          "type": "integer"
        },
        "nbRessourcesMobilisees": {
          "type": "integer"
        },
        "heuresTravailleesTotales": {
          "type": "number"
        }
      }
    },

    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alerts",
        "assignmentDiagnostics",
        "ignoredCreneaux"
      ],
      "properties": {
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alert"
          }
        },
        "assignmentDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssignmentDiagnostic"
          }
        },
        "ignoredCreneaux": {
          "$ref": "#/$defs/IgnoredCreneaux"
        }
      }
    },

    "Alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "date",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "message": {
          "type": "string"
        }
      }
    },

    "AssignmentDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creneauId",
        "date",
        "heureDebut",
        "heureFin",
        "activite",
        "status",
        "reasonCode",
        "message"
      ],
      "properties": {
        "creneauId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "heureDebut": {
          "type": "string"
        },
        "heureFin": {
          "type": "string"
        },
        "activite": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "UNCOVERED",
            "IMPOSSIBLE_TO_ASSIGN",
            "VIRTUAL_ASSIGNED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "NO_RESOURCE_ASSIGNED",
            "NO_COMPATIBLE_RESOURCE",
            "POSTE_VIRTUEL_ASSIGNED"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },

    "IgnoredCreneaux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horsHorizon",
        "sansRessource",
        "activiteInconnue"
      ],
      "properties": {
        "horsHorizon": {
          "type": "integer"
        },
        "sansRessource": {
          "type": "integer"
        },
        "activiteInconnue": {
          "type": "integer"
        }
      }
    }
  }
}