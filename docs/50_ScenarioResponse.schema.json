{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScenarioResponse.schema.json",
  "title": "ScenarioResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioType",
    "solverResult",
    "planning",
    "workMetrics",
    "solutionSummary",
    "diagnostics"
  ],
  "properties": {
    "scenarioType": {
      "type": "string"
    },
    "solverResult": {
      "$ref": "#/$defs/SolverResult"
    },
    "planning": {
      "$ref": "#/$defs/ScenarioPlanning"
    },
    "workMetrics": {
      "$ref": "#/$defs/WorkMetrics"
    },
    "solutionSummary": {
      "$ref": "#/$defs/SolutionSummary"
    },
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    },
    "candidats": {
      "type": "array",
      "description": "Propre à SC-06 : manières de couvrir le besoin, classées, trois au plus. La clé est ABSENTE — et non vide — pour SC-01 et SC-03 : une réponse sans classement ne doit pas laisser croire à une capacité inexistante.",
      "items": { "$ref": "#/$defs/Candidat" }
    }
  },
  "$defs": {
    "Candidat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rang", "conforme", "couvertureComplete", "nature", "affectations"],
      "description": "Une manière de couvrir le besoin, et son rang. Un candidat est une solution, pas une personne : l'affectation complète des créneaux du besoin. Classement par paliers : conformité → couverture complète → une seule personne et salarié réel d'abord → personne déjà en poste ce jour-là → score SOFT → charge rapportée au volume hebdomadaire habituel.",
      "properties": {
        "rang": { "type": "integer", "description": "1 = la solution la plus favorable" },
        "conforme": {
          "type": "boolean",
          "description": "false si une règle éliminatoire est violée. Ces solutions sont restituées et classées en dernier, jamais masquées : le moteur ne refuse pas, il rend visible l'impossible."
        },
        "couvertureComplete": { "type": "boolean" },
        "nature": {
          "type": "string",
          "enum": ["MONO_RESSOURCE", "COMPOSEE", "RESSOURCE_A_POURVOIR"]
        },
        "affectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/AffectationCandidat" }
        },
        "impacts": {
          "type": "array",
          "description": "Une entrée par ressource RÉELLE mobilisée. Vide pour une solution portée par un poste virtuel, qui ne porte ni contrat ni contraintes individuelles.",
          "items": { "$ref": "#/$defs/ImpactCandidat" }
        },
        "motifs": {
          "type": "array",
          "items": { "$ref": "#/$defs/MotifCandidat" }
        }
      }
    },
    "AffectationCandidat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creneauId", "ressourceId"],
      "properties": {
        "creneauId": { "type": "string" },
        "ressourceId": { "type": "string", "description": "A_AFFECTER si aucune ressource ne prend ce créneau en charge" },
        "activite": { "type": ["string", "null"] },
        "lieu": { "type": ["string", "null"] },
        "heureDebut": { "type": "string" },
        "heureFin": { "type": "string" }
      }
    },
    "ImpactMesure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avant", "apres", "delta", "depassement"],
      "description": "Grandeur mesurée avant et après affectation du besoin, en heures décimales. ATTENTION : un dépassement signalé décrit une conséquence, il ne garantit pas qu'une contrainte la sanctionne — c'est le cas de heuresJour, dont le plafond individuel n'est pas encore exploité par le moteur.",
      "properties": {
        "avant": { "type": "number" },
        "apres": { "type": "number" },
        "delta": { "type": "number" },
        "plafond": { "type": ["number", "null"], "description": "Limite individuelle du salarié, ou null si non renseignée. Une limite absente n'est pas une limite à zéro." },
        "depassement": { "type": "boolean" }
      }
    },
    "ImpactCandidat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ressourceId", "amplitudeJournaliere", "heuresJour", "heuresSemaine"],
      "properties": {
        "ressourceId": { "type": "string" },
        "amplitudeJournaliere": { "$ref": "#/$defs/ImpactMesure" },
        "heuresJour": { "$ref": "#/$defs/ImpactMesure" },
        "heuresSemaine": { "$ref": "#/$defs/ImpactMesure" },
        "heuresHabituellesSemaine": { "type": ["number", "null"] }
      }
    },
    "MotifCandidat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severite"],
      "description": "Même forme que diagnostics.alerts[] : le client filtre sur la sévérité, pas sur le code.",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "REPOS_QUOTIDIEN_INSUFFISANT",
            "HEURES_HEBDO_DEPASSEES",
            "JOUR_FERIE_NON_AUTORISE",
            "INDISPONIBILITE",
            "CHEVAUCHEMENT",
            "NUITS_CONSECUTIVES_DEPASSEES",
            "REPOS_APRES_NUITS_INSUFFISANT",
            "REPOS_HEBDOMADAIRE_GLISSANT_INSUFFISANT",
            "AMPLITUDE_DEPASSEE",
            "JOURS_CONSECUTIFS_DEPASSES",
            "DIMANCHES_TRAVAILLES_DEPASSES",
            "NUIT_SALARIE_NON_NUIT",
            "RAPPEL_SUR_REPOS",
            "BESOIN_PARTIELLEMENT_COUVERT",
            "AUCUNE_RESSOURCE_ELIGIBLE"
          ]
        },
        "severite": { "type": "string", "enum": ["INFO", "WARNING", "ERROR"] },
        "message": { "type": "string" }
      }
    },
    "SolverResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score",
        "scoreBreakdown"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SOLVED", "UNSOLVED", "ERROR"]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "scoreBreakdown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreBreakdownItem"
          }
        }
      }
    },

    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft"],
      "properties": {
        "hard": {
          "type": "integer"
        },
        "soft": {
          "type": "integer"
        }
      }
    },

    "ScoreBreakdownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "penaliteKey",
        "unit",
        "quantity",
        "weightedImpact"
      ],
      "properties": {
        "penaliteKey": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": [
            "OCCURRENCE",
            "JOUR",
            "MINUTE_PONDEREE"
          ]
        },
        "quantity": {
          "type": "number"
        },
        "weightedImpact": {
          "type": "integer"
        }
      }
    },

    "ScenarioPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idSalarie",
        "jours"
      ],
      "properties": {
        "idSalarie": {
          "type": "string"
        },
        "jours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JourPlanning"
          }
        }
      }
    },

    "JourPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "creneaux"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "creneaux": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CreneauPlanning"
          }
        }
      }
    },

    "CreneauPlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activite",
        "heureDebut",
        "heureFin",
        "duree",
        "ressourceAffecteeId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant du créneau, restitué à l'identique de l'entrée. Chaîne opaque : le moteur ne l'interprète pas. Clé de réintégration côté appelant. Les créneaux générés par le moteur portent le préfixe SC01- et ne désignent aucune ligne en base."
        },
        "lieu": {
          "type": ["string", "null"],
          "description": "Lieu reçu en entrée, restitué sans normalisation. null si le créneau n'en portait pas — cas des créneaux générés par le moteur."
        },
        "activite": {
          "type": "string"
        },
        "heureDebut": {
          "type": "string"
        },
        "heureFin": {
          "type": "string"
        },
        "duree": {
          "type": "string"
        },
        "nature": {
          "type": ["string", "null"]
        },
        "ressourceAffecteeId": {
          "type": "string"
        }
      }
    },

    "WorkMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byRessource",
        "global"
      ],
      "properties": {
        "byRessource": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkMetricsByRessource"
          }
        },
        "global": {
          "$ref": "#/$defs/GlobalWorkMetrics"
        }
      }
    },

    "WorkMetricsByRessource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "periodeDebut",
        "periodeFin",
        "heuresTravaillees",
        "heuresNuit",
        "heuresJourFerie",
        "heuresReposHebdoTravaille",
        "nbDimanchesTravailles",
        "maxJoursConsecutifsObservees",
        "maxNuitsConsecutivesObservees"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "periodeDebut": {
          "type": "string",
          "format": "date"
        },
        "periodeFin": {
          "type": "string",
          "format": "date"
        },
        "heuresTravaillees": {
          "type": "number"
        },
        "heuresNuit": {
          "type": "number"
        },
        "heuresJourFerie": {
          "type": "number"
        },
        "heuresReposHebdoTravaille": {
          "type": "number"
        },
        "nbDimanchesTravailles": {
          "type": "integer"
        },
        "maxJoursConsecutifsObservees": {
          "type": "integer"
        },
        "maxNuitsConsecutivesObservees": {
          "type": "integer"
        }
      }
    },

    "GlobalWorkMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbCreneaux",
        "nbCreneauxNonAffectes",
        "heuresTravailleesTotales",
        "heuresNuitTotales",
        "heuresJourFerieTotales"
      ],
      "properties": {
        "nbCreneaux": {
          "type": "integer"
        },
        "nbCreneauxNonAffectes": {
          "type": "integer"
        },
        "heuresTravailleesTotales": {
          "type": "number"
        },
        "heuresNuitTotales": {
          "type": "number"
        },
        "heuresJourFerieTotales": {
          "type": "number"
        }
      }
    },

    "SolutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbCreneaux",
        "nbCreneauxAffectes",
        "nbCreneauxNonAffectes",
        "nbRessourcesMobilisees",
        "heuresTravailleesTotales"
      ],
      "properties": {
        "nbCreneaux": {
          "type": "integer"
        },
        "nbCreneauxAffectes": {
          "type": "integer"
        },
        "nbCreneauxNonAffectes": {
          "type": "integer"
        },
        "nbRessourcesMobilisees": {
          "type": "integer"
        },
        "heuresTravailleesTotales": {
          "type": "number"
        }
      }
    },

    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alerts",
        "assignmentDiagnostics",
        "ignoredCreneaux"
      ],
      "properties": {
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alert"
          }
        },
        "assignmentDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssignmentDiagnostic"
          }
        },
        "ignoredCreneaux": {
          "$ref": "#/$defs/IgnoredCreneaux"
        }
      }
    },

    "Alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARNING", "ERROR"],
          "description": "Gravite de l'alerte. INFO = configuration atypique mais valide, ne pas restituer comme une anomalie. Absent = interpreter comme WARNING."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "message": {
          "type": "string"
        }
      }
    },

    "AssignmentDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creneauId",
        "date",
        "heureDebut",
        "heureFin",
        "activite",
        "status",
        "reasonCode",
        "message"
      ],
      "properties": {
        "creneauId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "heureDebut": {
          "type": "string"
        },
        "heureFin": {
          "type": "string"
        },
        "activite": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "UNCOVERED",
            "IMPOSSIBLE_TO_ASSIGN",
            "VIRTUAL_ASSIGNED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "NO_RESOURCE_ASSIGNED",
            "NO_COMPATIBLE_RESOURCE",
            "POSTE_VIRTUEL_ASSIGNED"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },

    "IgnoredCreneaux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horsHorizon",
        "saucuneRessourceDansDataset",
        "activiteInconnue"
      ],
      "properties": {
        "horsHorizon": {
          "type": "integer"
        },
        "sansRessource": {
          "type": "integer"
        },
        "activiteInconnue": {
          "type": "integer"
        }
      }
    }
  }
}