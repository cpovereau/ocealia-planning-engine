{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/scenario-sc01-v2.schema.json",
  "title": "Scenario SC-01 – Semaine type (salarié ou poste virtuel) – V2",
  "type": "object",
  "required": [
    "scenarioType",
    "planningContext",
    "scenarioParameters",
    "dataSet"
  ],
  "properties": {
    "scenarioType": {
      "const": "SC-01"
    },
    "planningContext": {
      "$ref": "ScenarioContract.schema.json#/properties/planningContext"
    },
    "scenarioParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRef",
        "dailyAmplitudeHours",
        "shiftStart",
        "shiftEndAlert",
        "workedDays"
      ],
      "properties": {
        "resourceRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "SALARIE",
                "POSTE_VIRTUEL"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Ressource cible pour laquelle générer une semaine type (salarié existant ou poste virtuel)."
        },
        "dailyAmplitudeHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Durée quotidienne totale (amplitude) incluant la pause réglementaire. Exemple: 8.0."
        },
        "shiftStart": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Heure de début de poste (HH:mm)."
        },
        "shiftEndAlert": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Heure de fin de poste (borne d'alerte). Si fin prévue > shiftEndAlert, une alerte est remontée."
        },
        "lunchBreak": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "description": "Pause de midi. Si absent, la pause par défaut est 12:00-13:00."
        },
        "workedDays": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          },
          "description": "Jours cochés comme travaillés (cases à cocher). Les jours non cochés sont qualifiés RH/RHD selon les règles SC-01."
        },
        "holidayDates": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          },
          "description": "Liste des jours fériés sur la période (YYYY-MM-DD). Non travaillés."
        }
      }
    },
    "dataSet": {
      "$ref": "ScenarioContract.schema.json#/properties/dataSet"
    }
  }
}